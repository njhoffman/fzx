#!/usr/bin/env bash
# fzx: fzf module manager. See docs/design.md.

set -o pipefail

# shellcheck source=../lib/core.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/core.sh"

fzx::usage() {
  cat << 'EOF'
usage: fzx                        open the menu of modules
       fzx -m|--mode <module[:mode]> [--popup[=OPTS]|--float[=OPTS]|--split[=DIR,SIZE]] [--query=Q] [--dry-run] [--keep] [--] [module args...]
       fzx --resume[=SID] [-m :mode] [--dry-run]
       fzx gc [--all]
       fzx stats [--since 90s|5m|2h|7d] [--module NAME] [--raw]
       fzx config [-m MODULE]
       fzx jump [--pick] [--] [WORDS...]   the directory g / gg cd into (shell/fzx.zsh)
       fzx keys [KEY...]          keys in use (KEYs as fzx's, your fzf binds, fzf's defaults) and free keys
       fzx builtin copy|copy-line|view|confirm [ARGS...]
       fzx debug ls | tail [SID] | attach [SID] | state [SID] [N] | send ACTION [SID]
       fzx completion zsh          print the zsh completion (#compdef fzx; modules and modes are looked up
                                   as you complete): fzx completion zsh > "${fpath[1]}/_fzx"

  -m, --mode MODULE[:MODE]
                     run MODULE (searched in $FZX_MODULE_PATH), optionally in MODE
      --resume[=SID] restart the interface for an existing session, reusing its cached data
                     (SID defaults to $FZX_SESSION)
      --popup[=OPTS] start in a tmux/Zellij popup (fzf --popup syntax, default $FZX_POPUP_OPTS)
      --float[=OPTS] start in a floating tmux pane (tmux new-pane; --popup syntax, default $FZX_FLOAT_OPTS)
      --split[=DIR,SIZE]
                     start in a tmux split pane (DIR up|down|left|right, default down,40%)
      --query=QUERY  start with QUERY typed in
      --dry-run      print the resolved fzf command instead of running it
      --keep         keep the session directory after exit (until `fzx gc --all`)
  -h, --help         show this help
  -V, --version      print the version

Arguments fzx does not recognise are passed to the module.
EOF
}

main() {
  case "${1:-}" in
    -V | --version)
      local version
      fzx::version version
      printf 'fzx %s\n' "$version"
      return
      ;;
    _cb)
      shift
      fzx::require callback
      fzx::callback "$@"
      return
      ;;
    debug)
      shift
      fzx::require log session debug
      fzx::debug "$@"
      return
      ;;
    jump)
      shift
      fzx::require log jump
      fzx::jump "$@"
      return
      ;;
    keys)
      shift
      fzx::require log keys
      fzx::keys_page "$@"
      return
      ;;
    builtin)
      shift
      fzx::require log builtin
      fzx::builtin "$@"
      return
      ;;
    stats)
      shift
      fzx::require log session config stats
      fzx::config_load
      fzx::stats "$@"
      return
      ;;
    config)
      shift
      fzx::require log session config
      [[ "${1:-}" == -m || "${1:-}" == --mode ]] && shift
      fzx::config_show "${1:-}"
      return
      ;;
    completion)
      shift
      fzx::require complete
      fzx::completion "$@"
      return
      ;;
    _complete)
      shift
      fzx::require complete
      fzx::complete "$@"
      return
      ;;
    gc)
      shift
      fzx::require log session gc
      fzx::gc "$@"
      return
      ;;
  esac

  local module="" resume=0 sid="" dry_run=0 keep="${FZX_KEEP:-0}" placement="" args=()
  while (($#)); do
    case "$1" in
      -m | --mode)
        [[ -n "${2:-}" ]] || fzx::die 2 "$1 requires a module name"
        module="$2"
        shift 2
        ;;
      --mode=*) module="${1#*=}" && shift ;;
      --resume=*) resume=1 sid="${1#*=}" && shift ;;
      --resume)
        resume=1
        shift
        if [[ -n "${1:-}" && "$1" != -* ]]; then
          sid="$1"
          shift
        fi
        ;;
      --popup) placement=popup && shift ;;
      --popup=*)
        placement="popup${1#--popup=}"
        [[ "$placement" == popup ]] || placement="popup:${1#--popup=}"
        shift
        ;;
      --float) placement=float && shift ;;
      --float=*)
        placement="float:${1#--float=}"
        [[ "$placement" != float: ]] || placement=float
        shift
        ;;
      --split) placement=split:down,40% && shift ;;
      --split=*)
        placement="split:${1#--split=}"
        [[ "$placement" != split: ]] || placement=split:down,40%
        shift
        ;;
      --query=*) _FZX_START_QUERY="${1#--query=}" && shift ;;
      --query)
        _FZX_START_QUERY="${2-}"
        shift 2 || shift
        ;;
      --dry-run) dry_run=1 && shift ;;
      --keep) keep=1 && shift ;;
      -h | --help)
        fzx::usage
        return 0
        ;;
      --)
        shift
        args+=("$@")
        break
        ;;
      *) args+=("$1") && shift ;;
    esac
  done

  fzx::require log session config opts run
  if ((resume)); then
    [[ -z "$module" || "$module" == :* ]] || fzx::die 2 "--resume takes only a mode (-m :MODE), not a module"
    fzx::run_resume "${sid:-${FZX_SESSION:-}}" "$dry_run" "${module#:}"
  else
    [[ -n "$placement" ]] || fzx::placement_from_fzf_tmux placement || :
    fzx::run_new "${module:-menu}" "$dry_run" "$keep" "$placement" "${args[@]}"
  fi
}

main "$@"
exit
